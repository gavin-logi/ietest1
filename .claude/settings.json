{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.release)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.release)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.secret)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.toml)",
      "Read(**/aws-credentials)",
      "Read(**/.aws/**)"
    ]
  }
}
