# 变更记录: 20261126-1437 新增宿主机端口可选项（同机多项目避免端口冲突）
# 变更记录: 20261125-0927 .env 与模板统一放回项目根目录（单一来源）；本机直跑的后端通过 ../.env 读取
# 变更记录: 20261125-0956 S3_PUBLIC_ENDPOINT_URL 增加用途说明（只用于生成预签名 URL，须与浏览器访问地址一致）
# 变更记录: 20261125-1035 增加跨设备测试说明（DJANGO_ALLOWED_HOSTS 与 S3_PUBLIC_ENDPOINT_URL 加入局域网 IP）
# 变更记录: 20261126-0841 Django 骨架：新增 APP_NAME / APP_DISPLAY_NAME、DJANGO_HTTPS、TRUSTED_PROXY_COUNT、会话时长等可选项
# 变更记录: 20261126-0902 新增 SSO（OIDC）配置，默认指向本地模拟 IdP
# 变更记录: 20261126-1032 DJANGO_CSRF_TRUSTED_ORIGINS 默认包含 http://localhost:5173（Vite 开发代理需要）
# 用法: cp .env.example .env  然后替换所有 CHANGE_ME

# --- 应用标识（派生新项目时修改这里，代码中不写项目名）---
# APP_NAME：机器用短名，只用小写字母、数字、- 和 _（用作镜像名 <APP_NAME>:local）
APP_NAME=app
# APP_DISPLAY_NAME：显示名，用于 Django 后台标题
APP_DISPLAY_NAME=App

# --- PostgreSQL（compose 读取，用于拼接 DATABASE_URL）---
# 密码必须只含 URL 安全字符（A-Z a-z 0-9 - _），因为会直接拼进 DATABASE_URL，不做编码
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- MinIO / S3（compose 读取；应用侧 S3_ACCESS_KEY_ID 目前复用 root 账号，后续应换成专用账号）---
MINIO_ROOT_USER=CHANGE_ME
# 同样只用 URL 安全字符，生成方式同上
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=CHANGE_ME
S3_REGION=us-east-1

# --- Django ---
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME
# 生产环境必须为 0
DJANGO_DEBUG=0
# 逗号分隔，不要带空格；跨设备测试时加入本机局域网 IP，例如 localhost,127.0.0.1,192.168.1.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 以下为可选项，不填时使用括号中的默认值
# 是否经 HTTPS 访问（0）。ECS + ALB 终止 TLS 时设为 1：启用 Secure Cookie 并信任 X-Forwarded-Proto。
# 本地 http 访问时必须为 0，否则浏览器不回传 cookie，无法登录
# DJANGO_HTTPS=0
# 应用前面的可信代理层数（0），用于从 X-Forwarded-For 取真实客户端 IP。ECS + ALB 设为 1；设置过大会让客户端可以伪造 IP
# TRUSTED_PROXY_COUNT=0
# CSRF 可信来源，逗号分隔，必须带协议、主机和端口。默认包含本地 Vite 开发服务器（5173），
# 因为 Vite 代理会把 Host 改为 8000，而浏览器的 Origin 仍是 5173，不加会导致 POST（如登出）返回 403。
# 同源部署（整套容器、生产 ALB）不需要；生产环境只填正式域名，不要保留开发地址。
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# 会话有效期，秒（43200 = 12 小时）。共享设备（如 PDA）建议更短
# DJANGO_SESSION_AGE_SECONDS=43200
# 页面显示用时区（Asia/Shanghai）；数据库存 UTC，日志固定 UTC
# DJANGO_TIME_ZONE=Asia/Shanghai
# 应用日志级别（INFO）
# LOG_LEVEL=INFO

# --- SSO（OIDC）---
# 下面的默认值指向本地模拟 IdP（docker compose up -d mock-idp），配合本机直跑的后端使用。
# 换成 Okta 时，按 docs/OIDC接入配置清单.md 申请后填写；正式环境的值由 Secrets Manager 注入，不放在 .env。
# OIDC_ISSUER 留空则关闭 SSO（/api/auth/login/ 返回 503）
# Okta 示例：https://<公司>.okta.com（org 授权服务器）或 https://<公司>.okta.com/oauth2/<授权服务器ID>
OIDC_ISSUER=http://localhost:8090/default
OIDC_CLIENT_ID=local-client
# 模拟 IdP 不校验，任意非空值即可；Okta 的 Client Secret 不要通过邮件传递
OIDC_CLIENT_SECRET=CHANGE_ME
# 必须与 Okta 应用中登记的 Sign-in redirect URI 完全一致（协议、域名、端口、路径、末尾斜杠）
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback/
# 登出后回到的地址；登出 IdP 时必须登记为 Okta 的 Sign-out redirect URI
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/
# 以下为可选项
# 识别用户的 claim（employeeNumber），对应 User.employee_number
# OIDC_USER_KEY_CLAIM=employeeNumber
# OIDC_SCOPES=openid profile email
# 首次登录自动创建用户（1）；设为 0 时只允许已预先开通的用户
# OIDC_CREATE_USERS=1
# 登出时同时结束 IdP 会话（1）；共享设备必须为 1
# OIDC_LOGOUT_FROM_IDP=1
# OIDC_HTTP_TIMEOUT=10

# --- 本机直跑（manage.py runserver，postgres / minio 以容器方式运行）---
# 这些地址只给本机直跑用；compose 启动时 environment 会覆盖它们（容器内使用 postgres / minio 主机名）
# 容器内镜像不含本文件，load_dotenv 找不到时静默跳过，配置全部来自 compose 注入的环境变量
# 下面的账号、密码需与上方 POSTGRES_* 和 MINIO_ROOT_* 保持一致
DATABASE_URL=postgres://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB
# S3_ENDPOINT_URL：应用内部读写对象用，compose 中会被覆盖为 http://minio:9000
S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL：只用于生成预签名 URL（浏览器下载链接），须与浏览器访问地址一致。
# 跨设备测试时改为 http://<本机局域网IP>:9000，compose 会读取此值；本机直跑时 localhost 即可
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# --- 宿主机端口（可选，括号内为默认值）---
# 同机已有其它项目占用默认端口时修改（compose 与本机直跑共用）。改后需同步 DATABASE_URL、S3_*_ENDPOINT_URL、OIDC_*_URI 中的端口
# POSTGRES_HOST_PORT=5432
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# MOCK_IDP_HOST_PORT=8090
# WEB_HOST_PORT=8000
# 本机直跑的后端（runserver）端口，Vite 的 /api 代理读取它（8000）
# BACKEND_PORT=8000
